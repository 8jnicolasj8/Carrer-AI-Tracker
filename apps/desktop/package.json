{
  "name": "career-ai-tracker",
  "version": "0.1.0",
  "description": "Desktop companion for FIFA 16 Career Mode",
  "main": "dist/main/index.js",
  "author": "Career AI Tracker Contributors",
  "license": "MIT",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --outfile=dist/main/index.js --external:electron",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node20 --outfile=dist/preload/index.js --external:electron",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "dev": "node scripts/dev.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  },
  "build": {
    "appId": "com.career.aitracker",
    "productName": "Career AI Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "locales/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Career AI Tracker"
    }
  }
}
